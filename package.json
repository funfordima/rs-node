{
  "name": "node-nodejs",
  "version": "1.0.0",
  "description": "Node JS",
  "engines": {
    "node": ">=24.10.0",
    "npm": ">=10.9.2"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && npx tsc-alias",
    "watch": "npx tsx watch src/index.ts",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "start:dev": "nodemon --exec npx tsx watch src/index.ts",
    "start:prod": "npm run build && node --enable-source-maps dist/index.js",
    "start:multi": "cross-env MULTI=true nodemon --exec npx tsx src/cluster.ts"
  },
  "author": "DmytroLitvinov",
  "license": "ISC",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@types/dotenv": "^8.2.0",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "uuid": "^9.0.1"
  }
}
